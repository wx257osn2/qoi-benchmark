Bootstrap: docker
From: ubuntu:26.04

%post -c /bin/bash

  set -euo pipefail

  GCC_VERSION=16.2.0
  CMAKE_VERSION=4.4.3

  DEBIAN_FRONTEND=noninteractive

  /installer/ubuntu$(source /etc/os-release; echo ${VERSION_ID//./})_prelude.bash
  /installer/ubuntu_gcc.bash ${GCC_VERSION}
  apt-get install -y --no-install-recommends make
  /installer/ubuntu_clang.bash 23 /opt/gcc-${GCC_VERSION}
  /installer/cmake.bash ${CMAKE_VERSION}
  RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo /installer/rustup.bash
  /installer/ubuntu2404_postlude.bash
  apt-get clean
  rm -rf /var/lib/apt/lists/* /var/cache/apt/*

  CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
  echo "#!/bin/bash" > ${CUSTOM_ENV}
  echo 'export PATH=${PATH}:'"/opt/cmake-${CMAKE_VERSION}/bin:/opt/gcc-${GCC_VERSION}/bin" >> ${CUSTOM_ENV}
  cat >> ${CUSTOM_ENV} << 'EOF'
export RUSTUP_HOME=/opt/rustup
export CARGO_HOME=/opt/cargo
source /opt/cargo/env
